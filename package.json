{
  "name": "broken-link-inspector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:locales": "node scripts/check-locales.mjs",
    "build": "npm run check:locales && npm run build:edge && npm run build:firefox",
    "fixtures": "node fixtures/server.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "build:edge": "vite build --mode edge",
    "build:firefox": "vite build --mode firefox",
    "package": "node scripts/package.mjs",
    "test:firefox": "node scripts/firefox-smoke.mjs",
    "test:locales-browser": "node scripts/locales-browser.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.65.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
